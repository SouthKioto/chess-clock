        <mxCell id="st-12" value="Pętla główna: zdarzenia = przyciskiPobierzZdarzenia(); jeśli != 0 → przejście + pokazStan(); następnie _delay_ms(30) i przyciskiReset() (odblokowanie przerwań po puszczeniu przycisku).&lt;br&gt;&lt;br&gt;pokazPoddanie(): LED4 (biała) ON na 1 s, potem kasuje zdarzenia z tego czasu.&lt;br&gt;&lt;br&gt;PAUZA (START w trakcie ruchu) — jeszcze nie zaimplementowana." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="st1">
          <mxGeometry x="1000" y="340" width="300" height="160" as="geometry" />
        </mxCell>
